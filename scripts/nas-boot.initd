#!/sbin/openrc-run
name="just-NAS boot display"
description="Early just-NAS text banner"
depend() {
 need devfs
 before hwdrivers modloop
}
start() {
 if [ -c /dev/tty1 ]; then
  prefix='\033[0m\033[H\033[2J'
  for option in $(cat /proc/cmdline); do
   [ "$option" = just_nas_boot=plain ] && prefix=''
  done
  printf '%b  [ JN ] just-NAS v2.1.0-rc4\r\n  Starting core services...\r\n\r\n  Alt+F2: Local maintenance console\r\n' "$prefix" > /dev/tty1
 fi
 return 0
}

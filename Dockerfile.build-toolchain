FROM golang:1.25.6-alpine3.23@sha256:98e6cffc31ccc44c7c15d83df1d69891efee8115a5bb7ede2bf30a38af3e3c92
RUN apk add --no-cache git
ENV GOTOOLCHAIN=local GOMAXPROCS=2 GOFLAGS=-buildvcs=false CGO_ENABLED=0
WORKDIR /src
CMD ["sh", "-ec", "go test -p 2 ./... && go vet -p 2 ./... && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -buildvcs=false -trimpath -ldflags='-s -w' -o /out/nas-server-linux ./cmd/nas-server"]

#!/sbin/openrc-run
name="nas-server"
description="Just NAS"
command="/usr/local/bin/nas-server"
command_background=true
pidfile="/run/nas-server.pid"
output_log="/var/log/nas-server-stdio.log"
error_log="/var/log/nas-server-stdio.log"
export PATH="/usr/libexec/rc/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
export TZ="${TZ:-Asia/Taipei}"
depend() {
 need localmount
 after networking modules modloop
}
start_pre() {
 checkpath -d -m 0700 /var/lib/just-nas
}

